# Direct Azure OpenAI: https://<resource>.openai.azure.com/
# Foundry: copy the exact Project endpoint from the deployed model screen.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Required for a direct Azure OpenAI endpoint; retained but ignored for Foundry/OpenAI-v1 endpoints.
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=
MAGENT_CONTENT_SAFETY_TIMEOUT_SECONDS=15
MAGENT_CHECKPOINT_DIR=data/checkpoints
MAGENT_CHROMA_DIR=data/chroma
MAGENT_RAG_RELEVANCE_THRESHOLD=0.2
MAGENT_MAX_CONTEXT_CHARACTERS=6000
MAGENT_MAX_CONTEXT_TOKENS=8000
MAGENT_MAX_TOKENS=2048
MAGENT_MAX_REVIEW_ROUNDS=5
MAGENT_CONVERSATION_LOG_DIR=data/conversations
MAGENT_SCANNER_TIMEOUT_SECONDS=60
MAGENT_SANDBOX_TIMEOUT_SECONDS=120
# Leave empty for host-mode DockerSandboxRunner; Compose overrides this with the worker URL.
MAGENT_SANDBOX_URL=
MAGENT_MAX_INPUT_CHARACTERS=4000
MAGENT_LLM_RETRY_MAX_ATTEMPTS=2
MAGENT_LLM_RETRY_BASE_SECONDS=1
MAGENT_LLM_RETRY_MAX_SECONDS=8
# Bounded retries for scanner, Docker, and sandbox-worker transport failures.
MAGENT_ADAPTER_RETRY_MAX_ATTEMPTS=2
MAGENT_ADAPTER_RETRY_BASE_SECONDS=0.5
MAGENT_ADAPTER_RETRY_MAX_SECONDS=5
MAGENT_PROVIDER=demo
# Optional: export traces to an OpenTelemetry Collector.
OTEL_SERVICE_NAME=magent-autogen
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# Better Auth — Next.js authentication
# ---------------------------------------------------------------------------
# Min 32 chars random string — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres used by Better Auth (Compose service `postgres`)
POSTGRES_USER=magent
POSTGRES_PASSWORD=magent
POSTGRES_DB=magent_auth
# Host-mode frontend (npm run dev) talks to published port 5432.
# Compose overrides DATABASE_URL to use the `postgres` hostname.
DATABASE_URL=postgres://magent:magent@localhost:5432/magent_auth

# First administrator created on container start / `npm run bootstrap-admin`.
# Password must be at least 8 characters. Change this before any shared deploy.
BOOTSTRAP_ADMIN_EMAIL=admin@localhost
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe_Admin8
BOOTSTRAP_ADMIN_NAME=Administrator

# Expose review round cap to frontend SelfHealingPanel (must match MAX_REVIEW_ROUNDS in backend)
NEXT_PUBLIC_MAX_REVIEW_ROUNDS=3
# Optional: Social login providers (leave empty to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# GitHub pull-request export (Task 3.3)
GITHUB_TOKEN=
GITHUB_REPO=owner/repository

# Terraform cost evidence (Task 3.5). Infracost v2 uses this token only inside
# the sandbox worker; never commit a real value. Local `infracost auth login`
# remains sufficient outside Compose; use a personal or service token here for Compose.
INFRACOST_CLI_AUTHENTICATION_TOKEN=
